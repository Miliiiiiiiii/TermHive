{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/plugin-sdk-v1/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "com.milii.termhive",
  "name": "TermHive",
  "version": "0.1.0-rc.1",
  "publisher": "milii",
  "description": "SSH terminal + SFTP file manager as native DBX connections. Open a saved connection to get a terminal and file transfers in a DBX tab.",
  "icon": "assets/plugin.svg",
  "engines": {
    "dbx": ">=0.5.68",
    "host_api": "1"
  },
  "entrypoints": {
    "backend": {
      "executable": "bin/dbx-plugin-termhive",
      "transport": "stdio-framed",
      "protocol_versions": [
        1
      ]
    },
    "ui": {
      "root": "ui/dist",
      "entry": "ui/dist/index.html"
    }
  },
  "permissions": [
    "host.workbench",
    "host.binary",
    "host.events",
    "host.ai"
  ],
  "contributions": [
    {
      "type": "connection-provider",
      "id": "com.milii.termhive.provider.ssh",
      "label": "SSH",
      "database_type": "ssh",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ],
      "workbench": "com.milii.termhive.workbench",
      "fields": [
        {
          "key": "display_name",
          "label": "连接名称",
          "type": "text",
          "binding": "name",
          "required": true,
          "default": "SSH 服务器"
        },
        {
          "key": "host",
          "label": "主机",
          "type": "text",
          "binding": "host",
          "required": true
        },
        {
          "key": "port",
          "label": "端口",
          "type": "number",
          "binding": "port",
          "default": 22
        },
        {
          "key": "username",
          "label": "用户名",
          "type": "text",
          "binding": "username"
        },
        {
          "key": "auth_method",
          "label": "认证方式",
          "type": "select",
          "binding": "config",
          "default": "password",
          "options": [
            {
              "label": "密码",
              "value": "password"
            },
            {
              "label": "私钥",
              "value": "key"
            }
          ]
        },
        {
          "key": "password",
          "label": "密码",
          "type": "password",
          "binding": "password",
          "visible_when": {
            "field": "auth_method",
            "one_of": [
              "password"
            ]
          }
        },
        {
          "key": "key_path",
          "label": "私钥文件",
          "type": "text",
          "binding": "config",
          "picker": {
            "kind": "file"
          },
          "visible_when": {
            "field": "auth_method",
            "one_of": [
              "key"
            ]
          }
        },
        {
          "key": "key_passphrase",
          "label": "私钥口令",
          "type": "password",
          "binding": "secret",
          "visible_when": {
            "field": "auth_method",
            "one_of": [
              "key"
            ]
          }
        },
        {
          "key": "encoding",
          "label": "字符编码",
          "type": "select",
          "binding": "config",
          "default": "utf-8",
          "options": [
            {
              "label": "UTF-8",
              "value": "utf-8"
            },
            {
              "label": "GBK",
              "value": "gbk"
            },
            {
              "label": "GB18030",
              "value": "gb18030"
            }
          ]
        },
        {
          "key": "keepalive_secs",
          "label": "Keepalive 间隔(秒)",
          "type": "number",
          "binding": "config",
          "default": 30
        },
        {
          "key": "connect_timeout",
          "label": "连接超时(秒)",
          "type": "number",
          "binding": "config",
          "default": 20
        },
        {
          "key": "startup_cmd",
          "label": "登录后执行命令",
          "type": "textarea",
          "binding": "config"
        }
      ]
    },
    {
      "type": "workbench",
      "id": "com.milii.termhive.workbench",
      "label": "TermHive",
      "description": "SSH terminal and SFTP file manager for saved DBX connections.",
      "icon": "assets/plugin.svg"
    },
    {
      "type": "workbench",
      "id": "com.milii.termhive.mini",
      "label": "TermHive Mini",
      "description": "Floating mini terminal window.",
      "icon": "assets/plugin.svg"
    },
    {
      "type": "workbench",
      "id": "com.milii.termhive.settings",
      "label": "TermHive Settings",
      "description": "Plugin-wide terminal style and log highlighting settings.",
      "icon": "assets/plugin.svg"
    },
    {
      "type": "mcp",
      "id": "com.milii.termhive.mcp",
      "external_tools": true,
      "tools": {
        "exec_readonly": {
          "access": "read",
          "toolset": "inspect"
        },
        "sftp_list_dir": {
          "access": "read",
          "toolset": "inspect"
        },
        "sftp_stat": {
          "access": "read",
          "toolset": "inspect"
        },
        "sftp_read_file": {
          "access": "read",
          "toolset": "inspect"
        },
        "sftp_write_file": {
          "access": "write",
          "toolset": "modify"
        },
        "sftp_mkdir": {
          "access": "write",
          "toolset": "modify"
        },
        "sftp_remove": {
          "access": "write",
          "toolset": "modify"
        },
        "sftp_rename": {
          "access": "write",
          "toolset": "modify"
        },
        "exec": {
          "access": "full",
          "toolset": "modify"
        }
      },
      "toolsets": [
        {
          "id": "inspect",
          "title": "Inspect",
          "description": "Read-only commands (whitelisted) and file reads over an open SSH connection"
        },
        {
          "id": "modify",
          "title": "Modify",
          "description": "File writes and arbitrary commands; exposed only after the user grants a higher access ceiling in DBX MCP settings"
        }
      ]
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "TermHive",
      "description": "SSH 终端 + SFTP 文件管理。以原生 DBX 连接的形式保存服务器,双击连接即可打开终端与文件传输。",
      "contributions": {
        "com.milii.termhive.provider.ssh": {
          "label": "SSH"
        },
        "com.milii.termhive.workbench": {
          "label": "TermHive",
          "description": "为已保存的 DBX 连接提供终端与文件管理。"
        },
        "com.milii.termhive.mini": {
          "label": "TermHive 小窗",
          "description": "浮动迷你终端窗口。"
        },
        "com.milii.termhive.settings": {
          "label": "TermHive 设置",
          "description": "插件级终端样式与日志着色设置。"
        }
      }
    }
  }
}